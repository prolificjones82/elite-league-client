{
    "name": "prolificjones/elite-league-client",
    "description": "Elite League API SDK in PHP",
    "type": "library",
    "minimum-stability": "stable",
    "autoload": {
		"psr-4": {
			"EliteLeagueClient\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"EliteLeagueClient\\Tests\\": "tests/"
		}
	},
    "authors": [
        {
            "name": "Lee Jones",
            "email": "mail@leejones.me.uk"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^8.3",
        "symfony/http-foundation": "^8.1",
        "monolog/monolog": "^3.12",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "php": "^8.4",
        "symfony/dotenv": "^8.1"
    },
    "scripts": {
		"typecheck": "./vendor/bin/phpstan analyse -c phpstan.neon --error-format=table || true",
		"test": "phpunit",
		"test-coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --coverage-text"
		],
		"format": "php-cs-fixer fix",
		"format:check": "php-cs-fixer check --diff"
	}
}
